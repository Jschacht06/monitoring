    {
      "id": 10,
      "title": "Guest CPU / API CPU capacity",
      "type": "timeseries",
      "description": "Hypervisor-reported usage compared with API-reported available CPU capacity; reconcile with the approved CPU accounting policy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
