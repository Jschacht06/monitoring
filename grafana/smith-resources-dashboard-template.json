{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Select the existing working Prometheus data source.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "id": null,
  "uid": null,
  "title": "Smith resource capacity and approved budgets",
  "description": "API-reported CPU/RAM capacity and usage for a reviewed single-cluster guest inventory, with approved group budgets and reviewed provisioned disk allocation. Requires local inventory/rules and coverage reconciliation; not complete physical storage or CPU quota accounting.",
  "tags": [
    "<your environment tag here>",
    "smith-resources",
    "noc"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "group",
        "label": "Group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values({__name__=~\"noc_guest_info|noc_group_cpu_budget_cores|noc_group_memory_budget_bytes|noc_group_disk_budget_bytes\"}, group)",
        "query": {
          "query": "label_values({__name__=~\"noc_guest_info|noc_group_cpu_budget_cores|noc_group_memory_budget_bytes|noc_group_disk_budget_bytes\"}, group)",
          "refId": "var-group"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0,
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Proxmox scrape health",
      "type": "stat",
      "description": "1=Up, 0=Failed; absent, duplicate or >=90s-old PVE scrape=Unknown. Exactly one job=pve target is supported. Success does not prove complete guest permissions or fresh underlying Proxmox host statistics.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "min(up{job=\"pve\"})\n  and on() (count(up{job=\"pve\"}) == 1)\n  and on() (time() - max(timestamp(up{job=\"pve\"})) < 90)",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failed",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Guests missing resource metrics",
      "type": "stat",
      "description": "Reviewed guests missing any required CPU/memory metric, including suppressed ambiguous identities or invalid source/capacity. Nonzero requires reconciliation; no reviewed inventory is Unknown. Use the detail table below.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "count(\n  noc_guest_info{group=~\"$group\"}\n  unless on(id) (\n    noc_guest_cpu_allocated_cores\n    and on(id) noc_guest_cpu_used_cores\n    and on(id) noc_guest_memory_allocated_bytes\n    and on(id) noc_guest_memory_used_bytes\n  )\n) or (0 * count(noc_guest_info{group=~\"$group\"}))",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Unmapped visible Smith guests",
      "type": "stat",
      "description": "Global count independent of group selection. Visible Smith guests without a mapping indicate a scoped/partial view. Unknown when the API source is invalid. Zero does not establish that a token can see every approved guest; reconcile the approved list.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "count(noc_smith_unmapped_guest_info) or (0 * noc_pve_source_ready)",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "API CPU capacity / approved vCPU budget",
      "type": "bargauge",
      "description": "API-reported available guest CPU capacity, including stopped guests when the API reports it, divided by approved group vCPU budget. Reconcile maxcpu with the approved allocation policy; it is not a CPU reservation/quota. Missing/nonpositive/duplicate budgets produce no bar. Colors are display thresholds, not alerts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * noc_group_cpu_allocated_cores{group=~\"$group\"} / on(group) (noc_group_cpu_budget_cores{group=~\"$group\"} > 0 and on(group) (count by(group) (noc_group_cpu_budget_cores{group=~\"$group\"}) == 1))",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "{{group}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          },
          "min": 0,
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "maxVizHeight": 300,
        "autoMinMax": false
      }
    },
    {
      "id": 5,
      "title": "API memory capacity / approved budget",
