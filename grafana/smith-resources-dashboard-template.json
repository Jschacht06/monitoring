    {
      "id": 7,
      "title": "Group CPU: used equivalents, API capacity, budget",
      "type": "timeseries",
      "description": "CPU busy core equivalents, API available CPU capacity, and reviewed approved budget. API capacity must match the budget accounting policy before interpreting it as allocation. Lines are comparisons, not additive; null gaps are not connected.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
