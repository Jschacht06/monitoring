    {
      "id": 6,
      "title": "Reviewed disk allocation / approved budget",
      "type": "bargauge",
      "description": "Reviewed provisioned disk inventory divided by approved disk budget. Static inventory stays available during API outages; this is not physical storage consumption. Missing/nonpositive/duplicate budgets produce no bar. Colors at 80%/95% are display thresholds, not alerts; actual displayed percentages can exceed 100%.",
      "datasource": {
