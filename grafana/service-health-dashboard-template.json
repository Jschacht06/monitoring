{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Select the existing working Prometheus data source.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "id": null,
  "uid": null,
  "title": "<your dashboard title here>",
  "description": "<your description here>",
  "tags": [
    "<your environment tag here>",
    "service-health",
    "noc"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "group",
        "label": "Group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(up{job=\"blackbox\",group!=\"\"}, group)",
        "query": {
          "query": "label_values(up{job=\"blackbox\",group!=\"\"}, group)",
          "refId": "var-group"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0,
        "regex": ""
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(up{job=\"blackbox\",group=~\"$group\",service!=\"\"}, service)",
        "query": {
          "query": "label_values(up{job=\"blackbox\",group=~\"$group\",service!=\"\"}, service)",
          "refId": "var-service"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0,
        "regex": ""
      },
      {
        "name": "probe_interval_s",
        "type": "constant",
        "query": "30",
        "current": {
          "text": "30",
          "value": "30"
        },
        "options": [
          {
            "text": "30",
            "value": "30",
            "selected": true
          }
        ],
        "hide": 2,
        "description": "Actual Blackbox scrape interval in seconds. Used only for coverage. Also set the status-history Min interval and the Prometheus datasource Scrape interval."
      },
      {
        "name": "probe_freshness_s",
        "type": "constant",
        "query": "90",
        "current": {
          "text": "90",
          "value": "90"
        },
        "options": [
          {
            "text": "90",
            "value": "90",
            "selected": true
          }
        ],
        "hide": 2,
        "description": "Maximum accepted up/probe sample age in seconds, exclusive. Default90 assumes30s scrapes; choose a tolerance longer than normal scrape completion/jitter."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Visible probe checks",
      "type": "stat",
      "description": "Checks with a currently queryable up series, including failed scrapes. This is observed monitoring inventory, not proof of complete service coverage. Missing inventory is Unknown/No data.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "count(up{job=\"blackbox\",group=~\"$group\",service=~\"$service\"})",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Failed destination checks",
      "type": "stat",
      "description": "Failed destination checks only with fresh probe_success and a fresh successful scrape. Zero alone does not prove every expected check is monitored or known.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "count((\n  probe_success{job=\"blackbox\",group=~\"$group\",service=~\"$service\"}\n  and on(job,instance,module,group,service,host,owner,contact,dependencies) (up{job=\"blackbox\",group=~\"$group\",service=~\"$service\"} == 1)\n  and on(job,instance,module,group,service,host,owner,contact,dependencies) (time() - timestamp(up{job=\"blackbox\",group=~\"$group\",service=~\"$service\"}) < $probe_freshness_s)\n  and on(job,instance,module,group,service,host,owner,contact,dependencies)\n  (time() - timestamp(probe_success{job=\"blackbox\",group=~\"$group\",service=~\"$service\"}) < $probe_freshness_s)\n) == 0)\nor (0 * count(up{job=\"blackbox\",group=~\"$group\",service=~\"$service\"}))",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Unknown probe checks",
      "type": "stat",
      "description": "Visible checks with failed scrapes, missing probe_success or samples older than probe_freshness_s (default 90s for 30s scrapes). Missing inventory gives Unknown/No data, not 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "count(((\n  probe_success{job=\"blackbox\",group=~\"$group\",service=~\"$service\"}\n  and on(job,instance,module,group,service,host,owner,contact,dependencies) (up{job=\"blackbox\",group=~\"$group\",service=~\"$service\"} == 1)\n  and on(job,instance,module,group,service,host,owner,contact,dependencies) (time() - timestamp(up{job=\"blackbox\",group=~\"$group\",service=~\"$service\"}) < $probe_freshness_s)\n  and on(job,instance,module,group,service,host,owner,contact,dependencies)\n  (time() - timestamp(probe_success{job=\"blackbox\",group=~\"$group\",service=~\"$service\"}) < $probe_freshness_s)\n)\nor on(job,instance,module,group,service,host,owner,contact,dependencies)\n(-1 + 0 * up{job=\"blackbox\",group=~\"$group\",service=~\"$service\"})) == -1)\nor (0 * count(up{job=\"blackbox\",group=~\"$group\",service=~\"$service\"}))",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Current probe checks",
      "type": "table",
      "description": "One row per visible probe:1 passed,0 failed,-1 unknown. Known states require successful fresh up and fresh probe_success samples (default<90s). Removed targets eventually disappear; compare with agreed inventory.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(\n  probe_success{job=\"blackbox\",group=~\"$group\",service=~\"$service\"}\n  and on(job,instance,module,group,service,host,owner,contact,dependencies) (up{job=\"blackbox\",group=~\"$group\",service=~\"$service\"} == 1)\n  and on(job,instance,module,group,service,host,owner,contact,dependencies) (time() - timestamp(up{job=\"blackbox\",group=~\"$group\",service=~\"$service\"}) < $probe_freshness_s)\n  and on(job,instance,module,group,service,host,owner,contact,dependencies)\n  (time() - timestamp(probe_success{job=\"blackbox\",group=~\"$group\",service=~\"$service\"}) < $probe_freshness_s)\n)\nor on(job,instance,module,group,service,host,owner,contact,dependencies)\n(-1 + 0 * up{job=\"blackbox\",group=~\"$group\",service=~\"$service\"})",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Up",
                        "color": "green"
                      },
                      "0": {
                        "text": "Down",
                        "color": "red"
                      },
                      "-1": {
                        "text": "Unknown",
                        "color": "#808080"
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "Unknown",
                        "color": "#808080"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true
            },
            "indexByName": {
              "group": 0,
              "service": 1,
              "host": 2,
              "module": 3,
              "instance": 4,
              "owner": 5,
              "contact": 6,
              "dependencies": 7,
              "Value": 8
            },
            "renameByName": {
              "group": "Group",
              "service": "Service",
              "host": "Host",
              "module": "Check",
              "instance": "Target",
              "owner": "Owner",
              "contact": "Contact",
              "dependencies": "Dependencies",
              "Value": "Status"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Probe status history",
      "type": "status-history",
      "description": "Sampled probe status at each query step: Up green, Down red, Unknown gray. Freshness is evaluated at each step. Max data points 200 and Min interval 30s coarsen long periods and can miss brief failures. Gaps are not filled.",
      "maxDataPoints": 200,
      "interval": "30s",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(\n  probe_success{job=\"blackbox\",group=~\"$group\",service=~\"$service\"}\n  and on(job,instance,module,group,service,host,owner,contact,dependencies) (up{job=\"blackbox\",group=~\"$group\",service=~\"$service\"} == 1)\n  and on(job,instance,module,group,service,host,owner,contact,dependencies) (time() - timestamp(up{job=\"blackbox\",group=~\"$group\",service=~\"$service\"}) < $probe_freshness_s)\n  and on(job,instance,module,group,service,host,owner,contact,dependencies)\n  (time() - timestamp(probe_success{job=\"blackbox\",group=~\"$group\",service=~\"$service\"}) < $probe_freshness_s)\n)\nor on(job,instance,module,group,service,host,owner,contact,dependencies)\n(-1 + 0 * up{job=\"blackbox\",group=~\"$group\",service=~\"$service\"})",
          "refId": "A",
          "format": "time_series",
          "instant": false,
          "range": true,
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Up",
                  "color": "green"
                },
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "-1": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 100
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "rowHeight": 0.8,
        "colWidth": 0.9,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "title": "Successful HTTP probe duration",
      "type": "timeseries",
      "description": "Total successful HTTP probe duration in seconds for modules named http_*. Filtered to fresh successful scrapes/probes. Includes connection/TLS work; failures create gaps. The 1s reference line must be checked against the agreed threshold and loaded ServiceSlow rule.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(\n  probe_duration_seconds{job=\"blackbox\",group=~\"$group\",service=~\"$service\",module=~\"http_.*\"}\n  and on(job,instance,module,group,service,host,owner,contact,dependencies) (probe_success{job=\"blackbox\",group=~\"$group\",service=~\"$service\",module=~\"http_.*\"} == 1)\n  and on(job,instance,module,group,service,host,owner,contact,dependencies) (up{job=\"blackbox\",group=~\"$group\",service=~\"$service\"} == 1)\n  and on(job,instance,module,group,service,host,owner,contact,dependencies) (time() - timestamp(up{job=\"blackbox\",group=~\"$group\",service=~\"$service\"}) < $probe_freshness_s)\n  and on(job,instance,module,group,service,host,owner,contact,dependencies)\n  (time() - timestamp(probe_success{job=\"blackbox\",group=~\"$group\",service=~\"$service\",module=~\"http_.*\"}) < $probe_freshness_s)\n  and on(job,instance,module,group,service,host,owner,contact,dependencies)\n  (time() - timestamp(probe_duration_seconds{job=\"blackbox\",group=~\"$group\",service=~\"$service\",module=~\"http_.*\"}) < $probe_freshness_s)\n)",
          "refId": "A",
          "format": "time_series",
          "instant": false,
          "range": true,
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "title": "Observed probe availability",
      "type": "stat",
      "description": "Percentage of recorded probe_success samples that succeeded over the selected period. Missing samples are excluded; visible checks without samples map to Unknown. Historical series can remain after removal. Read with coverage; this is not a service SLO.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(100 * avg_over_time(probe_success{job=\"blackbox\",group=~\"$group\",service=~\"$service\"}[$__range]))\nor on(job,instance,module,group,service,host,owner,contact,dependencies) (-1 + 0 * up{job=\"blackbox\",group=~\"$group\",service=~\"$service\"})",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#808080"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 100,
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 8,
      "title": "Probe sample coverage",
      "type": "stat",
      "description": "Approximate recorded probe_success samples / expected samples, using probe_interval_s (default 30). Visible checks with no samples in the period show 0. New targets, label changes, monitoring outages and retention reduce coverage; historical removed targets can remain.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "clamp_max(\n  100 * count_over_time(probe_success{job=\"blackbox\",group=~\"$group\",service=~\"$service\"}[$__range]) / ($__range_s / $probe_interval_s),\n  100\n)\nor on(job,instance,module,group,service,host,owner,contact,dependencies) (0 * up{job=\"blackbox\",group=~\"$group\",service=~\"$service\"})",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
