{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Select the existing working Prometheus data source.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "id": null,
  "uid": null,
  "title": "<your dashboard title here>",
  "description": "<your description here>",
  "tags": [
    "<your environment tag here>",
    "service-catalogue"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "probe_freshness_s",
        "type": "constant",
        "query": "90",
        "current": {
          "text": "90",
          "value": "90"
        },
        "options": [
          {
            "text": "90",
            "value": "90",
            "selected": true
          }
        ],
        "hide": 2,
        "description": "Maximum accepted scrape/probe sample age in seconds, exclusive. Default 90 assumes 30-second scrapes; match the health dashboard freshness tolerance."
      }
    ]
  },
  "panels": [
    {
      "id": 4,
      "title": "Current service probe status",
      "type": "table",
      "description": "One row per current Blackbox destination probe. Up=1, Down=0, Unknown=-1. Known results require fresh successful scrapes and fresh probe results, using probe_freshness_s (default 90 seconds for 30-second scrapes). Scrape-only inventory entries have no destination status. Removed targets eventually disappear; compare with the agreed service list.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(\n  probe_success{job=\"blackbox\"}\n  and on(job,instance,module,service,host,owner,contact,dependencies) (up{job=\"blackbox\"} == 1)\n  and on(job,instance,module,service,host,owner,contact,dependencies) (time() - timestamp(up{job=\"blackbox\"}) < $probe_freshness_s)\n  and on(job,instance,module,service,host,owner,contact,dependencies)\n  (time() - timestamp(probe_success{job=\"blackbox\"}) < $probe_freshness_s)\n)\nor on(job,instance,module,service,host,owner,contact,dependencies)\n(-1 + 0 * up{job=\"blackbox\"})",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Down",
                        "color": "red"
                      },
                      "1": {
                        "text": "Up",
                        "color": "green"
                      },
                      "-1": {
                        "text": "Unknown",
                        "color": "#808080"
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "Unknown",
                        "color": "#808080"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "noValue",
                "value": "Unknown"
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Group",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true
            },
            "indexByName": {
              "service": 0,
              "host": 1,
              "module": 2,
              "instance": 3,
              "owner": 4,
              "contact": 5,
              "dependencies": 6,
              "Value": 7
            },
            "renameByName": {
              "service": "Service",
              "host": "Host",
              "module": "Check",
              "instance": "Target",
              "owner": "Owner",
              "contact": "Contact",
              "dependencies": "Dependencies",
              "Value": "Status"
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Every monitored service",
      "description": "Current discovered scrape inventory from up, including failing scrapes. One row per service/host requires complete identity and identical owner/contact/dependencies across checks. Newly discovered targets need a first scrape; removed targets disappear after staleness processing. API exporter rows are collection checks, not guest inventories.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "count by (service, host, owner, contact, dependencies) (up)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Group",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "service": 0,
              "host": 1,
              "owner": 2,
              "contact": 3,
              "dependencies": 4,
              "Value": 5
            },
            "renameByName": {
              "service": "Service",
              "host": "Host",
              "owner": "Owner",
              "contact": "Contact person",
              "dependencies": "Dependencies",
              "Value": "Checks"
            }
          }
        }
      ]
    },
    {
      "id": 1,
      "title": "Services with incomplete catalogue metadata",
      "description": "Distinct service/host tuples with at least one check missing a required catalogue label. Missing identity labels can merge unrelated checks and undercount services: inspect job/instance/module in Explore. Zero only checks label presence on current up series; placeholders, bad metadata and undiscovered services need manual review. No data or an error requires investigation.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "count(count by (service, host) (up{service=\"\"} or up{host=\"\"} or up{owner=\"\"} or up{contact=\"\"} or up{dependencies=\"\"})) or (0 * count(up))",
          "format": "time_series",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Services missing catalogue metadata",
      "description": "Current up series missing service, host, owner, contact or dependencies, grouped by service/host. Missing identity labels can merge unrelated checks: inspect job/instance/module in Explore. Checks missing metadata counts incomplete checks, including failing scrapes. Empty/No data is expected only when the top inventory has data and the metadata counter is zero.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "count by (service, host) (up{service=\"\"} or up{host=\"\"} or up{owner=\"\"} or up{contact=\"\"} or up{dependencies=\"\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Group",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "service": 0,
              "host": 1,
              "Value": 2
            },
            "renameByName": {
              "service": "Service",
              "host": "Host",
              "Value": "Checks missing metadata"
            }
          }
        }
      ]
    }
  ]
}
